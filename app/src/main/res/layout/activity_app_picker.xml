<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/ink_white">

    <!-- listSelector 用纯色而不是主题默认的 Ripple：波纹动画在墨水屏上是连续残影 -->
    <ListView
        android:id="@+id/app_list"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:cacheColorHint="@color/ink_white"
        android:divider="@color/ink_black"
        android:dividerHeight="@dimen/stroke_normal"
        android:listSelector="@color/ink_press" />

    <TextView
        android:id="@+id/app_list_state"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:text="@string/app_list_loading"
        android:textColor="@color/ink_black"
        android:textSize="@dimen/text_body" />

</FrameLayout>
